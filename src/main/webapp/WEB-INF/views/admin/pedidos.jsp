<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1"><title>Pedidos</title><link rel="stylesheet" href="/css/nextfeet.css"></head><body><header><h1>NextFeet</h1><nav><a href="/home">Inicio</a><a href="/catalogo">Catálogo</a><a href="/ofertas">Ofertas</a><a href="/carrito">Carrito</a><c:choose><c:when test="${not empty sessionScope.usuario}"><a href="/perfil">Mi perfil</a><a href="/pedidos">Mis pedidos</a><a href="/logout">Salir</a></c:when><c:otherwise><a href="/login">Ingresar</a><a href="/registro">Registrarse</a></c:otherwise></c:choose></nav></header><main class="container"><h2>35 · Gestión de pedidos</h2><table><tr><th>Código</th><th>Cliente</th><th>Fecha</th><th>Total</th><th>Estado</th><th>Acciones</th></tr><c:forEach var="p" items="${pedidos}"><tr><td>${p.codigo}</td><td>${p.usuarioId}</td><td>${p.fecha}</td><td>${p.total}</td><td>${p.estado}</td><td><form method="post" action="/admin/pedidos/estado"><input type="hidden" name="id" value="${p.id}"><select name="estado"><option>EN_PREPARACION</option><option>EN_CAMINO</option><option>ENTREGADO</option></select><button>Actualizar</button></form><form method="post" action="/admin/pedidos/anular"><input type="hidden" name="id" value="${p.id}"><input name="motivo" placeholder="Motivo"><button class="danger">Anular</button></form></td></tr></c:forEach></table></main><footer>NextFeet · E-commerce de zapatillas</footer></body></html>