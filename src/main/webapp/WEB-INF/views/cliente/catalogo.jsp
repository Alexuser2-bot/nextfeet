<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><meta name="viewport" content="width=device-width, initial-scale=1"><title>Catálogo</title><link rel="stylesheet" href="/css/nextfeet.css"></head><body><header><h1>NextFeet</h1><nav><a href="/home">Inicio</a><a href="/catalogo">Catálogo</a><a href="/ofertas">Ofertas</a><a href="#" onclick="abrirCarrito();return false">Carrito</a><c:choose><c:when test="${not empty sessionScope.usuario}"><a href="/perfil">Mi perfil</a><a href="/pedidos">Mis pedidos</a><a href="/logout">Salir</a></c:when><c:otherwise><a href="/login">Ingresar</a><a href="/registro">Registrarse</a></c:otherwise></c:choose></nav></header><main class="container"><h2>Explora nuestras zapatillas</h2><a class="back-link" href="/home">← Volver al inicio</a><p>Encuentra el modelo ideal para tu estilo y presupuesto.</p><form class="card" method="get"><input name="q" placeholder="Buscar por nombre, marca o SKU"><input name="marca" placeholder="Marca"><select name="categoria"><option value="">Todas las categorías</option><c:forEach var="c" items="${categorias}"><option value="${c.id}">${c.nombre}</option></c:forEach></select><input name="min" type="number" step="0.01" placeholder="Precio mínimo"><input name="max" type="number" step="0.01" placeholder="Precio máximo"><button>Aplicar filtros</button></form><div class="grid product-grid"><c:forEach var="z" items="${zapatillas}"><article class="card product-card">
<img class="shoe-photo" src="/images/productos/${z.id}.jpg" onerror="this.onerror=null;this.src='/images/zapatilla.svg'" alt="Zapatilla ${z.nombre}">
<div class="product-info"><span class="product-brand"><c:out value="${z.marca}"/></span><h3><c:out value="${z.nombre}"/></h3><p class="product-description"><c:out value="${z.descripcion}"/></p><p class="price">S/ ${z.precio}</p></div>
<div class="product-actions"><button type="button" class="btn-detail" data-id="${z.id}" data-name="${z.nombre}" data-brand="${z.marca}" data-price="${z.precio}" data-description="${z.descripcion}" onclick="verDetalle(this)">Ver detalle</button>
<form method="post" action="/carrito/agregar" data-cart-form class="quick-add"><input type="hidden" name="zapatillaId" value="${z.id}"><label>Talla<select name="talla" required><option value="">Elegir talla</option><c:forEach var="t" begin="34" end="44"><option value="${t}">${t}</option></c:forEach></select></label><input type="hidden" name="cantidad" value="1"><button type="submit" class="btn-add">+ Agregar al carrito</button></form></div></article></c:forEach></div>
<dialog id="detalle-modal" class="detail-modal"><button type="button" class="modal-close" onclick="cerrarDetalle()" aria-label="Cerrar detalle">✕</button><div class="detail-layout"><img id="detalle-imagen" class="shoe-photo" alt="Imagen del producto"><div><p id="detalle-marca" class="product-brand"></p><h2 id="detalle-nombre"></h2><p id="detalle-descripcion"></p><p id="detalle-precio" class="price"></p><form method="post" action="/carrito/agregar" data-cart-form><input type="hidden" id="detalle-id" name="zapatillaId"><label>Talla<select name="talla" required><option value="">Selecciona tu talla</option><c:forEach var="t" begin="34" end="44"><option value="${t}">${t}</option></c:forEach></select></label><label>Cantidad<input type="number" name="cantidad" min="1" max="99" value="1" required></label><button type="submit" class="btn-add">Agregar al carrito</button></form><button type="button" class="back-link" onclick="cerrarDetalle()">← Seguir comprando</button></div></div></dialog></main><footer>NextFeet · E-commerce de zapatillas</footer><div class="cart-widget" id="cart-widget"><button type="button" class="cart-toggle" id="cart-toggle" aria-expanded="false" aria-controls="cart-panel">🛒 <span>Mi carrito</span> <span id="cart-arrow">▲</span></button><section id="cart-panel" class="cart-panel" hidden><div class="cart-heading"><strong>Tu carrito</strong><button type="button" id="cart-close" aria-label="Minimizar carrito">−</button></div><div id="cart-content">Cargando...</div></section></div><script src="/js/carrito-panel.js" defer></script><script src="/js/catalogo.js" defer></script></body></html>